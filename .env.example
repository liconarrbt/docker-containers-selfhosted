# ==========================================
# Configuración Stirling-PDF
# ==========================================
# Puerto en el host para acceder a Stirling-PDF
STIRLING_PORT=8080

# Idioma por defecto de la interfaz (es-ES, en-US, etc.)
STIRLING_DEFAULT_LOCALE=es-ES

# Requerir autenticación / login (true o false)
STIRLING_ENABLE_LOGIN=false

# Límite máximo para subida de archivos PDF
STIRLING_MAX_FILE_SIZE=2GB

# ==========================================
# Configuración Open-WA (wa-automate)
# ==========================================
# Puerto en el host para acceder a la API de Open-WA
OPENWA_PORT=8082

# Clave API secreta para proteger las peticiones a Open-WA
OPENWA_API_KEY=tu_clave_secreta_aqui

# Identificador de la sesión de WhatsApp
OPENWA_SESSION_ID=sesion-whatsapp
