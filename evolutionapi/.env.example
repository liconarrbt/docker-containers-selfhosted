# ==========================================
# Configuración del Servidor Evolution API
# ==========================================
# Puerto en el host para acceder a la API de Evolution
EVOLUTION_PORT=8085

# Puerto en el host para acceder al panel web (Evolution Manager)
EVOLUTION_MANAGER_PORT=8086

# URL base pública o local de la API
SERVER_URL=http://localhost:8085

# ==========================================
# Autenticación y Seguridad
# ==========================================
AUTHENTICATION_TYPE=apikey
# Clave API secreta global para administrar instancias (inventada por ti)
AUTHENTICATION_API_KEY=tu_clave_secreta_aqui

# ==========================================
# Caché Redis (contenedor interno incluido)
# ==========================================
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution

# ==========================================
# Conexión a Base de Datos PostgreSQL
# ==========================================
# Si tu Postgres corre en tu máquina (puerto 5432), usa host.docker.internal
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://postgres:tu_password_postgres@host.docker.internal:5432/evolution_db?schema=evolution_api'
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Persistencia de datos en la base de datos
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_DELETE_MESSAGE=true

# ==========================================
# Ajustes Generales
# ==========================================
DEL_INSTANCE=false
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
