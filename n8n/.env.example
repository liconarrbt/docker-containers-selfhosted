# ==========================================
# Configuración n8n
# ==========================================
# Host y Dominio (usa localhost si es local, o tu dominio si tienes proxy/túnel)
N8N_HOST=localhost

# Credenciales de autenticación básica (opcional en versiones v1+)
N8N_USER=admin
N8N_PASSWORD=admin_password

# Clave de cifrado interna para proteger credenciales dentro de n8n
N8N_ENCRYPTION_KEY=clave_de_encriptacion_super_secreta

# ==========================================
# Conexión a PostgreSQL (postgres:latest)
# ==========================================
# Si tu contenedor de Postgres está expuesto en tu Mac (puerto 5432): usa host.docker.internal
# Si están en la misma red de Docker: usa el nombre del contenedor de Postgres
DB_POSTGRESDB_HOST=host.docker.internal
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=tu_password_postgres
